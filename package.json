  "description": "Secure administrator impersonation module for Brocoders",
  "license": "GPL-2.0-only",
  "type": "module",
  "sideEffects": false,
  "files": [
    "api/package.json",
    "api/dist",
    "web/src/modules/impersonate",
    "web/src/services/i18n/locales"
  ],
  "exports": {
    ".": "./web/src/modules/impersonate/index.ts",
    "./web": "./web/src/modules/impersonate/index.ts",
    "./manifest": "./web/src/modules/impersonate/module.manifest.ts",
    "./api": {
      "types": "./api/dist/index.d.ts",
      "require": "./api/dist/index.js",
      "default": "./api/dist/index.js"
    },
    "./api/manifest": {
      "types": "./api/dist/impersonate/impersonate.manifest.d.ts",
      "require": "./api/dist/impersonate/impersonate.manifest.js",
      "default": "./api/dist/impersonate/impersonate.manifest.js"
    },
    "./api/definition": {
      "types": "./api/dist/impersonate/impersonate.definition.d.ts",
      "require": "./api/dist/impersonate/impersonate.definition.js",
      "default": "./api/dist/impersonate/impersonate.definition.js"
    },
    "./api/entities": {
      "types": "./api/dist/impersonate/impersonate.entities.d.ts",
      "require": "./api/dist/impersonate/impersonate.entities.js",
      "default": "./api/dist/impersonate/impersonate.entities.js"
    },
    "./api/migrations": {
      "types": "./api/dist/impersonate/database/migrations/index.d.ts",
      "require": "./api/dist/impersonate/database/migrations/index.js",
      "default": "./api/dist/impersonate/database/migrations/index.js"
    },
    "./api/seeds": {
      "types": "./api/dist/impersonate/impersonate.seeds.d.ts",
      "require": "./api/dist/impersonate/impersonate.seeds.js",
      "default": "./api/dist/impersonate/impersonate.seeds.js"
    },
    "./locales/en": "./web/src/services/i18n/locales/en/module-impersonate.json",
    "./locales/id": "./web/src/services/i18n/locales/id/module-impersonate.json"
  },
  "scripts": {
    "build:api": "tsc -p api/tsconfig.build.json",
    "prepare": "npm run build:api",
    "verify:api-package": "node scripts/verify-api-package.mjs"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
